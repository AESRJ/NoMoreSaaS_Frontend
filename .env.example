# Variables de desarrollo local. Copiar a .env (ignorado por Git) y completar.
# Este ejemplo no contiene secretos; nunca versionar el .env real ni la DB.
# La API y la web escuchan solo en la interfaz local por defecto.
API_HOST=127.0.0.1
API_PORT=3001
WEB_HOST=127.0.0.1
WEB_PORT=5173

# Base SQLite local. Vacío = apps/api/.local/data/nomoresaas.sqlite (ignorado).
# Si se define debe ser una ruta absoluta; dentro del repositorio solo bajo un
# directorio .local, nunca en dist/public. No se admite base en memoria.
DATABASE_PATH=

# Origen exacto de la web. http solo se admite en loopback de desarrollo; en
# cualquier otro host se exige https y la cookie se marca Secure.
APP_ORIGIN=http://127.0.0.1:5173

# Secreto de firma de sesión: obligatorio, estable entre reinicios y de al
# menos 32 bytes. Generar localmente, por ejemplo:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Acceso con Google (opcional). Las tres o ninguna: vacías = Google desactivado
# (sin botón); solo algunas = la API no arranca. Valores reales solo en el .env
# local o en variables protegidas del entorno, nunca en Git. GOOGLE_REDIRECT_URI
# debe ser exactamente APP_ORIGIN + /api/auth/google/callback y estar registrada
# en el cliente de Google. Guía: .project/docs/setup-google.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
