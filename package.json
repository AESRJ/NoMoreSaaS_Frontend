{
  "name": "nomoresaas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel --stream run dev",
    "db:migrate": "pnpm --filter @nomoresaas/api run db:migrate",
    "lint": "eslint .",
    "test": "pnpm --recursive run test",
    "build": "pnpm --filter @nomoresaas/web run build",
    "test:e2e": "playwright test",
    "start": "pnpm --filter @nomoresaas/api start"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0"
  }
}
